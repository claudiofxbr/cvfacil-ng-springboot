# ============================================================
# CVFacil.NG — Variáveis de Ambiente (Raiz, somente documentação)
# ============================================================
# Este arquivo LISTA todas as variáveis usadas pelo monorepo.
# Para configurar localmente:
#   - Frontend: copie frontend/.env.local.example -> frontend/.env.local
#   - Backend:  copie backend/src/main/resources/application-local.yml.example
#               -> backend/src/main/resources/application-local.yml
# ============================================================

# ---- Frontend (Next.js) ------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Backend (Spring Boot) ---------------------------------
# Banco (Neon PostgreSQL)
DATABASE_URL=jdbc:postgresql://HOST/DB?sslmode=require
DATABASE_USERNAME=cvfacil_app
DATABASE_PASSWORD=replace-me

# Cache / Rate limit
REDIS_URL=redis://localhost:6379

# JWT (PEM RS256, base64 ou multi-line)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
JWT_ISSUER=https://cvfacil.ng
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# IA (PROVEDOR CONFIGURÁVEL — NUNCA COMMITAR A CHAVE REAL)
# Em produção, defina AI_API_KEY nas variáveis de ambiente da Hostinger.
# Provedores suportados: gemini | openai | anthropic (ou qualquer OpenAI-compatible via AI_API_BASE_URL)
AI_PROVIDER=gemini
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=AIza-REPLACE-ME
AI_MODEL=gemini-flash-latest

# URL base do frontend — usada para montar o link de redefinição de senha
FRONTEND_BASE_URL=http://localhost:3000

# SMTP transacional
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@cvfacil.ng
SMTP_PASSWORD=replace-me

# Criptografia column-level (AES-256-GCM)
ENCRYPTION_MASTER_KEY=base64:REPLACE_WITH_32_BYTES_KEY

# RootMaster
ROOT_IP_ALLOWLIST=203.0.113.0/24,198.51.100.42/32
ROOT_MFA_ISSUER=CVFacil.NG Root
