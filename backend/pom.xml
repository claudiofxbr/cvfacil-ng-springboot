<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.12: corrige CVE-2026-22733 (bypass de autenticacao no Actuator sob
             endpoints CloudFoundry).
             3.5.16: corrige a leva de CVEs de 05/09/2026 nas versoes gerenciadas de
             tomcat-embed-core (CVE-2026-41293 CRITICAL e outras), netty-handler
             (CVE-2026-44249/45416/50010) e spring-webmvc/spring-expression
             (CVE-2026-41842/41845/41850) — nenhuma delas exige mudanca de codigo,
             so a versao mais nova das dependencias transitivas gerenciadas pelo BOM. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ng.cvfacil</groupId>
    <artifactId>cvfacil-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>CVFacil.NG Backend</name>
    <description>API REST — Spring Boot 3.3, Java 21</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- CVE-2026-54512 (execucao de codigo arbitrario em jackson-databind): a 2.19.4
             herdada do BOM do Spring Boot 3.5.12 nao recebeu backport; a serie 2.19.x nao
             foi corrigida, so 2.18.8+, 2.21.4+ e 3.1.4+. Sobe todo o jackson-bom junto (nao
             so jackson-databind) para manter databind/annotations/core na mesma versao —
             misturar versoes do family Jackson quebra o ObjectMapper em runtime. -->
        <jackson-bom.version>2.21.4</jackson-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>16.2.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- commons-io é transitivo (via poi-ooxml) com versões conflitantes no grafo
                 (2.11.0/2.15.0/2.15.1/2.16.1); fixado aqui para eliminar a ambiguidade que
                 fazia o Trivy reportar CVE-2024-47554 contra 2.11.0 mesmo com o Maven
                 mediando para 2.16.1 em tempo de build. -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.16.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security + OAuth2 + Resource Server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- 42.7.12: corrige CVE-2026-42198 (DoS via SCRAM-SHA-256 malicioso) e
                 CVE-2026-54291 (bypass de protecao MITM via downgrade SCRAM-SHA-256-PLUS) -->
            <version>42.7.12</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Cache / Rate limit -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Mail -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Sanitização HTML (OWASP) -->
        <dependency>
            <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
            <artifactId>owasp-java-html-sanitizer</artifactId>
            <!-- 20260101.1: corrige CVE-2025-66021 (XSS) -->
            <version>20260101.1</version>
        </dependency>

        <!-- HIBP k-anonymity (HTTP client usa HttpClient padrão) -->

        <!-- Extração de texto de PDF (importação de currículo via IA) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- Extração de texto de DOCX (importação de currículo via IA) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.3.0</version>
        </dependency>

        <!--
          OCR para PDFs escaneados (sem camada de texto).
          tess4j é um wrapper JNA para o Tesseract OCR.
          REQUISITO: Tesseract 5 deve estar instalado no SO:
            Windows : https://github.com/UB-Mannheim/tesseract/wiki
            Ubuntu  : sudo apt install tesseract-ocr tesseract-ocr-por
            macOS   : brew install tesseract tesseract-lang
          Habilitado apenas quando cvfacil.ocr.enabled=true (default: false).
        -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>5.11.0</version>
        </dependency>

        <!-- Dev local: Postgres embarcado (profile "local"). Binarios por SO em profiles Maven abaixo. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>compile</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.43.0</version>
                <configuration>
                    <java>
                        <googleJavaFormat><version>1.22.0</version></googleJavaFormat>
                        <importOrder/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Baixa o binario Postgres apenas para o SO em uso: evita arrastar ~1GB desnecessario. -->
        <profile>
            <id>embedded-pg-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>embedded-pg-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>embedded-pg-mac</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-amd64</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
